---
---

<section class="relative pt-6 pb-10 md:pt-10 md:pb-12 overflow-hidden">
  <div class="text-center max-w-4xl mx-auto space-y-4">
    
    <!-- Status Pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-orbynex-surfaceDark/90 border border-slate-200 dark:border-orbynex-lineDark text-[11px] font-mono text-orbynex-cyan shadow-glowCyan">
      <span class="w-2 h-2 rounded-full bg-orbynex-cyan animate-pulse"></span>
      <span class="tracking-wide uppercase font-semibold">Orbynex Digital System</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-display font-black tracking-tight text-slate-900 dark:text-white leading-tight">
      Herramientas e Insumos <span class="text-gradient">Informáticos</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-sm sm:text-base text-slate-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed">
      Catálogo curado de aplicaciones esenciales, calculadoras de ingeniería, guías de desarrollo y recursos de infraestructura.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a
        href="/blog/apps"
        class="px-6 py-2.5 rounded-xl font-display font-bold text-xs bg-gradient-to-r from-orbynex-cyan via-orbynex-blue to-orbynex-magenta text-white shadow-glowCyan hover:shadow-glowMagenta hover:scale-105 transition-all duration-300"
      >
        Explorar Catálogo 🚀
      </a>
      <a
        href="/blog/calculadoras"
        class="px-6 py-2.5 rounded-xl font-display font-bold text-xs bg-slate-100 dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-700 dark:text-gray-200 hover:text-white hover:border-orbynex-cyan transition-all duration-300"
      >
        Calculadoras 🧮
      </a>
      <a
        href="/blog/guias"
        class="px-6 py-2.5 rounded-xl font-display font-bold text-xs bg-slate-100 dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-700 dark:text-gray-200 hover:text-white hover:border-orbynex-cyan transition-all duration-300"
      >
        Guías Técnicas 📚
      </a>
    </div>

    <!-- Live Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-6 max-w-3xl mx-auto">
      <div class="p-3 rounded-xl bg-white dark:bg-orbynex-surfaceDark/60 border border-slate-200 dark:border-orbynex-lineDark shadow-sm backdrop-blur-md">
        <span class="block font-display text-xl font-black text-orbynex-cyan">+50</span>
        <span class="text-[10px] text-slate-500 dark:text-gray-400 font-medium">Herramientas & Apps</span>
      </div>
      <div class="p-3 rounded-xl bg-white dark:bg-orbynex-surfaceDark/60 border border-slate-200 dark:border-orbynex-lineDark shadow-sm backdrop-blur-md">
        <span class="block font-display text-xl font-black text-orbynex-magenta">6</span>
        <span class="text-[10px] text-slate-500 dark:text-gray-400 font-medium">Calculadoras Activas</span>
      </div>
      <div class="p-3 rounded-xl bg-white dark:bg-orbynex-surfaceDark/60 border border-slate-200 dark:border-orbynex-lineDark shadow-sm backdrop-blur-md">
        <span class="block font-display text-xl font-black text-orbynex-blue">+15</span>
        <span class="text-[10px] text-slate-500 dark:text-gray-400 font-medium">Guías Públicas</span>
      </div>
      <div class="p-3 rounded-xl bg-white dark:bg-orbynex-surfaceDark/60 border border-slate-200 dark:border-orbynex-lineDark shadow-sm backdrop-blur-md">
        <span class="block font-display text-xl font-black text-white">100%</span>
        <span class="text-[10px] text-slate-500 dark:text-gray-400 font-medium">Libre & Gratuito</span>
      </div>
    </div>

  </div>
</section>
