---
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <div class="text-center max-w-4xl mx-auto space-y-6">
    
    <!-- Status Pill -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orbynex-surfaceDark/90 border border-orbynex-lineDark text-xs font-mono text-orbynex-cyan shadow-glowCyan animate-pulse">
      <span class="w-2 h-2 rounded-full bg-orbynex-cyan"></span>
      <span class="tracking-wide uppercase font-semibold">Orbynex Digital System</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-black tracking-tight text-white leading-[1.1]">
      Herramientas e Insumos <br />
      <span class="text-gradient">Informáticos de Alto Nivel</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
      Catálogo curado de aplicaciones esenciales, calculadoras de ingeniería, guías de desarrollo y recursos de infraestructura para estudiantes y profesionales.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
      <a
        href="/blog/apps"
        class="px-7 py-3.5 rounded-2xl font-display font-bold text-sm bg-gradient-to-r from-orbynex-cyan via-orbynex-blue to-orbynex-magenta text-white shadow-glowCyan hover:shadow-glowMagenta hover:scale-105 transition-all duration-300"
      >
        Explorar Catálogo de Apps 🚀
      </a>
      <a
        href="/blog/guias"
        class="px-7 py-3.5 rounded-2xl font-display font-bold text-sm bg-orbynex-surfaceDark/90 border border-orbynex-lineDark text-gray-200 hover:text-white hover:border-orbynex-cyan hover:bg-orbynex-surfaceStrong transition-all duration-300"
      >
        Ver Guías Técnicas 📚
      </a>
    </div>

    <!-- Live Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-12 max-w-3xl mx-auto">
      <div class="p-4 rounded-2xl bg-orbynex-surfaceDark/60 border border-orbynex-lineDark backdrop-blur-md">
        <span class="block font-display text-2xl sm:text-3xl font-black text-orbynex-cyan">+50</span>
        <span class="text-xs text-gray-400 font-medium">Herramientas & Apps</span>
      </div>
      <div class="p-4 rounded-2xl bg-orbynex-surfaceDark/60 border border-orbynex-lineDark backdrop-blur-md">
        <span class="block font-display text-2xl sm:text-3xl font-black text-orbynex-magenta">4</span>
        <span class="text-xs text-gray-400 font-medium">Calculadoras Interactivas</span>
      </div>
      <div class="p-4 rounded-2xl bg-orbynex-surfaceDark/60 border border-orbynex-lineDark backdrop-blur-md">
        <span class="block font-display text-2xl sm:text-3xl font-black text-orbynex-blue">100%</span>
        <span class="text-xs text-gray-400 font-medium">Libre & Gratuito</span>
      </div>
      <div class="p-4 rounded-2xl bg-orbynex-surfaceDark/60 border border-orbynex-lineDark backdrop-blur-md">
        <span class="block font-display text-2xl sm:text-3xl font-black text-white">v2.0</span>
        <span class="text-xs text-gray-400 font-medium">Plataforma Actualizada</span>
      </div>
    </div>

  </div>
</section>
