---
import { pricingPlans } from '../data/pricing';
---
<section id="planes" class="space-y-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-400">Planes y precios</p>
      <h2 class="text-3xl font-semibold text-white">Escala según tu modelo de negocio</h2>
    </div>
    <p class="max-w-2xl text-sm text-slate-400">
      Comienza gratis y desbloquea funciones premium solo cuando necesites monetizar con marca blanca, analíticas avanzadas o equipos colaborativos.
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {pricingPlans.map(plan => (
      <article
        class={`flex h-full flex-col rounded-2xl border p-6 shadow transition ${
          plan.highlighted
            ? 'border-blue-500/50 bg-blue-500/10 shadow-blue-500/25'
            : 'border-slate-800 bg-slate-900/60 shadow-blue-500/10'
        }`}
      >
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-300">{plan.name}</p>
        <div class="mt-4 flex items-baseline gap-2">
          <span class="text-4xl font-bold text-white">{plan.price}</span>
          <span class="text-sm text-slate-400">{plan.billing}</span>
        </div>
        <p class="mt-3 text-sm text-slate-300">{plan.description}</p>
        <ul class="mt-6 space-y-3 text-sm text-slate-200">
          {plan.features.map(feature => (
            <li class="flex items-start gap-2">
              <span class="mt-1 text-blue-300">✔</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <a
          href={plan.ctaHref}
          class={`mt-8 inline-flex items-center justify-center rounded-full px-5 py-2 text-sm font-semibold transition ${
            plan.highlighted
              ? 'bg-white text-blue-600 hover:bg-slate-100'
              : 'border border-slate-700 text-slate-200 hover:border-blue-400 hover:text-blue-200'
          }`}
        >
          {plan.ctaLabel}
        </a>
      </article>
    ))}
  </div>
</section>
