---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  showSubtitle?: boolean;
}

const { size = 'md', showSubtitle = true } = Astro.props;

const sizes = {
  sm: { icon: 'w-6 h-6', title: 'text-base', sub: 'text-[10px]' },
  md: { icon: 'w-8 h-8', title: 'text-xl', sub: 'text-xs' },
  lg: { icon: 'w-10 h-10', title: 'text-2xl', sub: 'text-sm' },
};
---

<div class="flex items-center gap-2.5 group select-none">
  <!-- Isotipo Orbynex TIC -->
  <div class={`relative flex items-center justify-center ${sizes[size].icon} rounded-xl bg-gradient-to-br from-orbynex-cyan via-orbynex-blue to-orbynex-magenta p-[1.5px] shadow-glowCyan group-hover:scale-105 transition-transform duration-300`}>
    <div class="w-full h-full bg-orbynex-deepSpace dark:bg-orbynex-deepSpace rounded-[10px] flex items-center justify-center overflow-hidden">
      <svg class="w-3/5 h-3/5 text-orbynex-cyan group-hover:text-white transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
      </svg>
    </div>
  </div>

  <!-- Texto de la Marca -->
  <div class="flex flex-col">
    <span class={`font-display font-extrabold tracking-tight ${sizes[size].title} text-white dark:text-white group-hover:text-orbynex-cyan transition-colors duration-300`}>
      Herramientas<span class="text-gradient">TIC</span>
    </span>
    {showSubtitle && (
      <span class={`font-mono font-medium ${sizes[size].sub} text-orbynex-cyan/80 tracking-wider uppercase -mt-1`}>
        by Orbynex Digital
      </span>
    )}
  </div>
</div>
