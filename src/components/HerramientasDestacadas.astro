---
import { tools } from '../data/tools.js';

const herramientasDestacadas = tools.slice(0, 6);
---

<section class="py-12 border-t border-slate-200 dark:border-orbynex-lineDark">
  <div class="flex items-center justify-between mb-8">
    <div>
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-orbynex-cyan">Selección Esencial</span>
      <h2 class="text-2xl sm:text-3xl font-display font-black text-slate-900 dark:text-white mt-1">Apps & Insumos Destacados</h2>
    </div>
    <a href="/blog/apps" class="text-xs font-display font-bold text-orbynex-cyan hover:underline hidden sm:block">
      Ver todas (+50) →
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {herramientasDestacadas.map((tool) => (
      <a
        href={tool.link}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative p-5 rounded-2xl bg-white dark:bg-[#0c1b3a] border border-slate-200 dark:border-orbynex-lineDark hover:border-orbynex-cyan/60 hover:-translate-y-1 transition-all duration-300 shadow-cardLight dark:shadow-cardDark flex flex-col justify-between cursor-pointer"
      >
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl p-2 rounded-xl bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">{tool.emoji}</span>
            <div>
              <h3 class="font-display font-bold text-lg text-slate-900 dark:text-white group-hover:text-orbynex-cyan transition-colors">
                {tool.title}
              </h3>
              <span class="text-[10px] font-mono text-orbynex-cyan uppercase">Insumo Recomendado</span>
            </div>
          </div>
          <p class="text-xs text-slate-500 dark:text-gray-400 leading-relaxed mb-4">
            {tool.description}
          </p>
        </div>

        <div
          class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-slate-100 dark:bg-orbynex-deepSpace text-slate-700 dark:text-gray-200 group-hover:bg-orbynex-blue group-hover:text-white border border-slate-200 dark:border-orbynex-lineDark transition-all duration-200"
        >
          Visitar sitio oficial ↗
        </div>
      </a>
    ))}
  </div>
</section>
