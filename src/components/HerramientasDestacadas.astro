---
import { tools } from '../data/tools.js';

const herramientasDestacadas = tools.slice(0, 6);
---

<section class="py-12">
  <div class="flex items-center justify-between mb-8">
    <div>
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-orbynex-magenta">Selección Esencial</span>
      <h2 class="text-2xl sm:text-3xl font-display font-black text-white mt-1">Herramientas Recomendadas</h2>
    </div>
    <a href="/blog/apps" class="text-xs font-display font-bold text-orbynex-cyan hover:underline hidden sm:block">
      Ver todas (+50) →
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {herramientasDestacadas.map((tool) => (
      <div class="group relative p-5 rounded-2xl bg-orbynex-surfaceDark/60 border border-orbynex-lineDark hover:border-orbynex-blue/50 hover:bg-orbynex-surfaceStrong transition-all duration-300 shadow-cardDark flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl p-2 rounded-xl bg-orbynex-deepSpace border border-orbynex-lineDark">{tool.emoji}</span>
            <div>
              <h3 class="font-display font-bold text-lg text-white group-hover:text-orbynex-cyan transition-colors">
                {tool.title}
              </h3>
              <span class="text-[10px] font-mono text-orbynex-cyan/80 uppercase">Insumo Imprescindible</span>
            </div>
          </div>
          <p class="text-xs text-gray-400 leading-relaxed mb-4">
            {tool.description}
          </p>
        </div>

        <a
          href={tool.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 w-full py-2 px-3 rounded-xl text-xs font-bold bg-orbynex-deepSpace hover:bg-orbynex-blue text-gray-200 hover:text-white border border-orbynex-lineDark hover:border-orbynex-blue transition-all duration-200"
        >
          Visitar sitio oficial ↗
        </a>
      </div>
    ))}
  </div>
</section>
