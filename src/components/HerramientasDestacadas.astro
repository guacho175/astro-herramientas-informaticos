---
import Categorias from './Categorias.astro';
import MenuHamburguesa from './MenuHamburguesa.astro';

interface Props {
  active?: string;
  title?: string;
  description?: string;
}

const { active = 'apps', title, description }: Props = Astro.props;
---
<section class="w-full space-y-10">
  <div class="grid gap-10 lg:grid-cols-[280px,1fr]">
    <aside class="space-y-6 rounded-2xl border border-slate-800 bg-slate-900/60 p-6 shadow-lg shadow-blue-500/5">
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-400">Explora categorías</p>
        <h3 class="text-2xl font-semibold text-white">{title ?? 'Herramientas destacadas'}</h3>
        {description && <p class="text-sm text-slate-400">{description}</p>}
      </div>
      <Categorias active={active} />
    </aside>

    <div class="space-y-6">
      <slot />
    </div>
  </div>

  <MenuHamburguesa active={active} />
</section>
