---
import { siteConfig } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-slate-800 bg-slate-950/80">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 md:px-6 lg:grid-cols-4 lg:px-8">
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <img src="/logo-tec.png" alt="Logo" class="h-10 w-10 rounded-lg border border-slate-800" />
        <div>
          <p class="text-sm uppercase tracking-[0.3em] text-blue-400">{siteConfig.hero.eyebrow}</p>
          <p class="text-lg font-semibold text-white">{siteConfig.name}</p>
        </div>
      </div>
      <p class="text-sm text-slate-400">{siteConfig.description}</p>
      <a
        href={`mailto:${siteConfig.contactEmail}`}
        class="inline-flex items-center gap-2 text-sm font-semibold text-blue-300 transition hover:text-blue-200"
      >
        <span>📧 {siteConfig.contactEmail}</span>
      </a>
    </div>

    <div class="space-y-3">
      <h4 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Navegación</h4>
      <nav class="flex flex-col gap-2 text-sm text-slate-400">
        {siteConfig.navigation.map(link => (
          <a href={link.href} class="transition hover:text-blue-300">{link.label}</a>
        ))}
      </nav>
    </div>

    <div class="space-y-3">
      <h4 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Monetización</h4>
      <ul class="space-y-2 text-sm text-slate-400">
        {siteConfig.monetization.premiumFeatures.map(feature => (
          <li>• {feature}</li>
        ))}
      </ul>
    </div>

    <div class="space-y-3">
      <h4 class="text-sm font-semibold uppercase tracking-wide text-slate-300">Síguenos</h4>
      <div class="flex flex-col gap-2 text-sm text-slate-400">
        {siteConfig.social.map(item => (
          <a href={item.href} class="transition hover:text-blue-300" target="_blank" rel="noreferrer">{item.label}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-slate-800 bg-slate-950/60 py-4 text-center text-xs text-slate-500">
    <p>
      &copy; {year} {siteConfig.name}. Todos los derechos reservados. ·
      <a href="/politicas" class="underline hover:text-blue-300">Políticas de privacidad</a>
    </p>
  </div>
</footer>
