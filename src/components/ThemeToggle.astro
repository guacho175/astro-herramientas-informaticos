---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Cambiar Tema Claro/Oscuro"
  title="Cambiar Tema"
  class="relative p-2 rounded-xl border border-slate-200 dark:border-orbynex-lineDark bg-white dark:bg-orbynex-surfaceDark text-orbynex-cyan hover:text-orbynex-blue transition-all duration-200 shadow-sm flex items-center justify-center group"
>
  <!-- Sol (Modo Claro Activo -> Muestra icono de Luna para cambiar a oscuro) -->
  <svg
    id="theme-toggle-light-icon"
    class="w-5 h-5 hidden text-amber-500 group-hover:rotate-45 transition-transform duration-300"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
  </svg>

  <!-- Luna (Modo Oscuro Activo -> Muestra icono de Sol para cambiar a claro) -->
  <svg
    id="theme-toggle-dark-icon"
    class="w-5 h-5 hidden text-orbynex-cyan group-hover:-rotate-12 transition-transform duration-300"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>
