---
---
<div class="space-y-4">
  <div>
    <div class="flex justify-between text-xs font-mono text-gray-300 mb-1">
      <span>Longitud deseada:</span>
      <span id="pass-len-lbl" class="text-orbynex-cyan font-bold">16 caracteres</span>
    </div>
    <input type="range" id="pass-slider" min="8" max="64" value="16" class="w-full accent-orbynex-cyan" />
  </div>

  <div class="grid grid-cols-2 gap-3 text-xs font-mono text-slate-700 dark:text-gray-300">
    <label class="flex items-center gap-2 cursor-pointer p-2 rounded bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
      <input type="checkbox" id="chk-upper" checked class="accent-orbynex-cyan" /> Mayúsculas (A-Z)
    </label>
    <label class="flex items-center gap-2 cursor-pointer p-2 rounded bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
      <input type="checkbox" id="chk-lower" checked class="accent-orbynex-cyan" /> Minúsculas (a-z)
    </label>
    <label class="flex items-center gap-2 cursor-pointer p-2 rounded bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
      <input type="checkbox" id="chk-nums" checked class="accent-orbynex-cyan" /> Números (0-9)
    </label>
    <label class="flex items-center gap-2 cursor-pointer p-2 rounded bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
      <input type="checkbox" id="chk-syms" checked class="accent-orbynex-cyan" /> Símbolos (!@#$)
    </label>
  </div>

  <div class="p-4 rounded-xl bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-magenta/40 flex items-center justify-between gap-3">
    <span id="pass-res-out" class="font-mono text-base text-orbynex-magenta font-bold truncate">GeneratePass123!</span>
    <button id="copy-pass-action" type="button" class="px-4 py-2 rounded-lg text-xs font-bold bg-orbynex-blue text-white hover:bg-orbynex-cyan hover:text-black transition-all shrink-0">
      Copiar 📋
    </button>
  </div>
</div>

<script>
  function initPassGen() {
    const slider = document.getElementById('pass-slider') as HTMLInputElement;
    const lbl = document.getElementById('pass-len-lbl');
    const chkU = document.getElementById('chk-upper') as HTMLInputElement;
    const chkL = document.getElementById('chk-lower') as HTMLInputElement;
    const chkN = document.getElementById('chk-nums') as HTMLInputElement;
    const chkS = document.getElementById('chk-syms') as HTMLInputElement;
    const passRes = document.getElementById('pass-res-out');
    const copyBtn = document.getElementById('copy-pass-action');

    if (!slider || !lbl || !chkU || !chkL || !chkN || !chkS || !passRes || !copyBtn) return;

    function genPass() {
      const len = parseInt(slider.value);
      lbl!.textContent = `${len} caracteres`;
      let pool = '';
      if (chkU.checked) pool += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      if (chkL.checked) pool += 'abcdefghijklmnopqrstuvwxyz';
      if (chkN.checked) pool += '0123456789';
      if (chkS.checked) pool += '!@#$%^&*()_+-=[]{}|;:,.<>?';
      
      if (!pool) { passRes!.textContent = 'Selecciona una opción'; return; }
      
      let out = '';
      for (let i = 0; i < len; i++) out += pool.charAt(Math.floor(Math.random() * pool.length));
      passRes!.textContent = out;
    }

    slider.addEventListener('input', genPass);
    chkU.addEventListener('change', genPass);
    chkL.addEventListener('change', genPass);
    chkN.addEventListener('change', genPass);
    chkS.addEventListener('change', genPass);
    genPass();

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(passRes!.textContent || '');
      copyBtn.textContent = '¡Copiado! ✓';
      setTimeout(() => copyBtn.textContent = 'Copiar 📋', 2000);
    });
  }

  document.addEventListener('astro:page-load', initPassGen);
</script>
