---
const { tutorials } = Astro.props;
---
<div class="space-y-6">
  {tutorials.map(tut => (
    <article
      class="tutorial-item flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 shadow shadow-blue-500/10 transition hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-blue-500/20 md:flex-row"
      data-search={`${tut.data.title} ${tut.data.description}`}
    >
      <img
        class="h-48 w-full object-cover md:h-auto md:w-48"
        src={tut.data.image}
        alt={tut.data.title}
        loading="lazy"
      />
      <div class="flex flex-1 flex-col justify-between gap-4 p-6">
        <div class="space-y-3">
          <a href={`/blog/guias/${tut.slug}`} class="inline-flex items-center gap-2 text-sm font-semibold text-blue-300 hover:text-blue-200">
            Leer guía completa
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6" />
            </svg>
          </a>
          <h3 class="text-xl font-semibold text-white">{tut.data.title}</h3>
          <p class="text-sm text-slate-300">{tut.data.description}</p>
        </div>
        <p class="text-xs text-slate-500">Última actualización: {tut.data.updated}</p>
      </div>
    </article>
  ))}
</div>
