---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import CategoryDrawer from './CategoryDrawer.astro';
import SymbolRain from './SymbolRain.astro';

const navItems = [
  { name: 'Apps & Insumos', href: '/blog/apps' },
  { name: 'Calculadoras', href: '/blog/calculadoras' },
  { name: 'Guías & Tutoriales', href: '/blog/guias' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Contacto', href: '/contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full glass-panel border-b border-orbynex-lineDark transition-all duration-300 relative overflow-hidden">
  <!-- Lluvia de símbolos informáticos de fondo en Header -->
  <SymbolRain density={10} opacity={0.12} />

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Left side: Category Drawer trigger + Brand Logo (Redirecciona al inicio) -->
      <div class="flex items-center gap-3 sm:gap-4">
        <!-- Category Drawer Button -->
        <button
          id="toggle-category-drawer"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-orbynex-surfaceDark/90 border border-orbynex-lineDark text-gray-300 hover:text-orbynex-cyan hover:border-orbynex-cyan/50 text-xs font-bold transition-all duration-200"
          aria-label="Abrir panel de categorías"
        >
          <span class="text-sm">🗂️</span>
          <span class="hidden sm:inline">Categorías</span>
        </button>

        <!-- Brand Logo (Redirección a Inicio /) -->
        <a href="/" class="flex items-center" aria-label="Ir a Inicio">
          <Logo size="md" />
        </a>
      </div>

      <!-- Desktop Navigation Links (Sin botón Inicio) -->
      <nav class="hidden lg:flex items-center space-x-1">
        {navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 ${
                isActive
                  ? 'text-orbynex-cyan bg-orbynex-blue/15 border border-orbynex-cyan/30 shadow-glowCyan'
                  : 'text-gray-300 hover:text-white hover:bg-orbynex-surfaceStrong/60'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions (Search, Theme, Mobile Toggle) -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        
        <!-- Search Trigger Button -->
        <button
          id="global-search-btn"
          type="button"
          class="hidden md:flex items-center space-x-2 px-3 py-1.5 rounded-xl bg-orbynex-surfaceDark/80 border border-orbynex-lineDark text-gray-400 hover:text-white hover:border-orbynex-cyan/50 text-xs transition-all duration-200"
        >
          <svg class="w-3.5 h-3.5 text-orbynex-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Buscar...</span>
          <kbd class="px-1.5 py-0.5 text-[9px] font-mono bg-orbynex-deepSpace rounded border border-gray-700 text-gray-400">Ctrl K</kbd>
        </button>

        <!-- Theme Switcher -->
        <ThemeToggle />

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2 rounded-xl border border-orbynex-lineDark bg-orbynex-surfaceDark text-gray-300 hover:text-white hover:border-orbynex-cyan transition-all duration-200"
          aria-label="Abrir menú de navegación"
        >
          <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-orbynex-lineDark bg-orbynex-deepSpace/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2 relative z-20">
    {navItems.map((item) => {
      const isActive = currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class={`block px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 ${
            isActive
              ? 'text-orbynex-cyan bg-orbynex-blue/20 border border-orbynex-cyan/30'
              : 'text-gray-300 hover:text-white hover:bg-orbynex-surfaceDark'
          }`}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</header>

<!-- Include Category Drawer -->
<CategoryDrawer />

<script is:inline>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      mobileMenu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });
</script>
