---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Apps & Insumos', href: '/blog/apps' },
  { name: 'Calculadoras', href: '/blog/calculadoras' },
  { name: 'Guías & Tutoriales', href: '/blog/guias' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Contacto', href: '/contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full glass-panel border-b border-orbynex-lineDark transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center">
        <Logo size="md" />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-xl text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'text-orbynex-cyan bg-orbynex-blue/15 border border-orbynex-cyan/30 shadow-glowCyan'
                  : 'text-gray-300 hover:text-white hover:bg-orbynex-surfaceStrong/60'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Actions (Search trigger, Theme toggle, Mobile Menu button) -->
      <div class="flex items-center space-x-3">
        
        <!-- Search Trigger Button -->
        <button
          id="global-search-btn"
          type="button"
          class="hidden sm:flex items-center space-x-2 px-3 py-1.5 rounded-xl bg-orbynex-surfaceDark/80 border border-orbynex-lineDark text-gray-400 hover:text-white hover:border-orbynex-cyan/50 text-xs transition-all duration-200"
        >
          <svg class="w-4 h-4 text-orbynex-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Buscar...</span>
          <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-orbynex-deepSpace rounded border border-gray-700 text-gray-400">Ctrl K</kbd>
        </button>

        <!-- Theme Switcher -->
        <ThemeToggle />

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2 rounded-xl border border-orbynex-lineDark bg-orbynex-surfaceDark text-gray-300 hover:text-white hover:border-orbynex-cyan transition-all duration-200"
          aria-label="Abrir menú de navegación"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-orbynex-lineDark bg-orbynex-deepSpace/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-2">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-4 py-2.5 rounded-xl text-base font-medium transition-all duration-200 ${
            isActive
              ? 'text-orbynex-cyan bg-orbynex-blue/20 border border-orbynex-cyan/30'
              : 'text-gray-300 hover:text-white hover:bg-orbynex-surfaceDark'
          }`}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</header>

<script is:inline>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      mobileMenu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });
</script>
