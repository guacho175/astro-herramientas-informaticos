---
import { siteConfig } from '../config/site';
const editorial = siteConfig.editorial;
---
<section class="space-y-8 rounded-3xl border border-blue-500/30 bg-gradient-to-br from-slate-950 via-slate-950 to-blue-950/40 p-8 shadow-xl shadow-blue-500/20">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-300">Colecciones destacadas</p>
      <h2 class="text-3xl font-bold text-white">Explora series pensadas para tu próximo proyecto</h2>
      <p class="max-w-2xl text-sm text-blue-100">{editorial.intro}</p>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    {editorial.pillars.map(pillar => (
      <a
        href={pillar.href}
        class="flex h-full flex-col gap-3 rounded-2xl border border-blue-500/20 bg-slate-900/60 p-5 text-left transition hover:-translate-y-1 hover:border-blue-400/50 hover:shadow-lg hover:shadow-blue-500/20"
      >
        <span class="text-lg font-semibold text-blue-100">{pillar.title}</span>
        <p class="text-sm text-blue-50/90">{pillar.description}</p>
        <span class="mt-auto text-xs font-semibold uppercase tracking-[0.3em] text-blue-300">Ver contenidos →</span>
      </a>
    ))}
  </div>
</section>
