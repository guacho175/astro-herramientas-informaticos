---
import { siteConfig } from '../config/site';
const premium = siteConfig.monetization;
---
<section id="premium" class="space-y-8 rounded-3xl border border-blue-500/30 bg-gradient-to-br from-slate-950 via-slate-950 to-blue-950/40 p-8 shadow-xl shadow-blue-500/20">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
    <div class="space-y-3">
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-300">Versión premium</p>
      <h2 class="text-3xl font-bold text-white">{premium.premiumProduct}</h2>
      <p class="max-w-2xl text-sm text-blue-100">{premium.promise}</p>
    </div>
    <a
      href="#planes"
      class="inline-flex items-center justify-center rounded-full bg-white/10 px-6 py-3 text-sm font-semibold text-blue-100 transition hover:bg-white/20"
    >
      Ver planes disponibles
    </a>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    {premium.premiumFeatures.map(feature => (
      <div class="flex items-start gap-3 rounded-2xl border border-blue-500/20 bg-slate-900/60 p-5">
        <span class="mt-1 text-lg text-blue-300">★</span>
        <p class="text-sm text-blue-100">{feature}</p>
      </div>
    ))}
  </div>
</section>
