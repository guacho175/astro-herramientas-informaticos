---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
}

const {
  title = "HerramientasTIC | Recursos, Apps y Calculadoras Informáticas por Orbynex Digital",
  description = "Portal de utilidades, aplicaciones esenciales, calculadoras de ingeniería y tutoriales de desarrollo de software por Orbynex Digital.",
  keywords = "informática, herramientas, apps, desarrollo, calculadoras, guías, tutoriales, orbynex",
  image = "/favicon.svg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://herramientastic.orbynexdigital.cl');
---

<!DOCTYPE html>
<html lang="es" data-theme="dark" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts con swap no bloqueante -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Montserrat:wght@600;700;800;900&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

    <!-- ClientRouter SPA View Transitions -->
    <ClientRouter />

    <!-- OpenGraph / Social Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Theme & Global App Controller -->
    <script is:inline>
      function getSavedTheme() {
        return localStorage.getItem('orbynex-theme') || 
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'dark');
      }

      function syncThemeUI(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        const lightIcon = document.getElementById('theme-toggle-light-icon');
        const darkIcon = document.getElementById('theme-toggle-dark-icon');

        if (theme === 'dark') {
          lightIcon?.classList.add('hidden');
          darkIcon?.classList.remove('hidden');
        } else {
          darkIcon?.classList.add('hidden');
          lightIcon?.classList.remove('hidden');
        }
      }

      function initAppController() {
        const theme = getSavedTheme();
        syncThemeUI(theme);
      }

      // Delegación de Eventos Global (Infalible en todas las páginas)
      if (!window.__orbynex_controller_initialized) {
        window.__orbynex_controller_initialized = true;

        document.addEventListener('click', (e) => {
          // 1. Toggle Tema
          const themeBtn = e.target.closest('#theme-toggle');
          if (themeBtn) {
            const currentTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            localStorage.setItem('orbynex-theme', currentTheme);
            syncThemeUI(currentTheme);
            return;
          }

          // 2. Toggle Category Drawer
          const categoryBtn = e.target.closest('#toggle-category-drawer, #toggle-category-drawer-mobile');
          if (categoryBtn) {
            const categoryDrawer = document.getElementById('category-drawer');
            const categoryDrawerOverlay = document.getElementById('category-drawer-overlay');
            categoryDrawer?.classList.remove('translate-x-full');
            categoryDrawerOverlay?.classList.remove('hidden');
            return;
          }

          // 3. Close Category Drawer
          const categoryCloseBtn = e.target.closest('#close-category-drawer, #category-drawer-overlay');
          if (categoryCloseBtn) {
            const categoryDrawer = document.getElementById('category-drawer');
            const categoryDrawerOverlay = document.getElementById('category-drawer-overlay');
            categoryDrawer?.classList.add('translate-x-full');
            categoryDrawerOverlay?.classList.add('hidden');
            return;
          }
        });
      }

      initAppController();
      document.addEventListener('astro:after-swap', initAppController);
      document.addEventListener('astro:page-load', initAppController);
    </script>
  </head>

  <body class="min-h-screen flex flex-col font-sans selection:bg-orbynex-cyan selection:text-black">
    
    <!-- Background Grid Pattern & Reactive Glow Orb -->
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="glow-orb" id="glow-orb" aria-hidden="true"></div>

    <!-- Header Navigation Persistente -->
    <Header transition:persist />

    <!-- Search Modal Ctrl+K Persistente -->
    <SearchModal transition:persist />

    <!-- Main Content Slot -->
    <main class="flex-1 w-full relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" transition:animate="fade">
      <slot />
    </main>

    <!-- Footer Persistente -->
    <Footer transition:persist />

    <!-- Mouse Tracking Script Eficiente (Sin loops infinitos) -->
    <script is:inline>
      if (!window.__orbynex_mouse_initialized) {
        window.__orbynex_mouse_initialized = true;
        let ticking = false;

        window.addEventListener('mousemove', (e) => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              document.documentElement.style.setProperty('--glow-x', `${e.clientX}px`);
              document.documentElement.style.setProperty('--glow-y', `${e.clientY}px`);
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>
