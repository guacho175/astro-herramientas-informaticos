---
import Layout from '../../../layouts/Layout.astro';
import TutorialIcon from '../../../components/TutorialIcon.astro';
import { tutorialService } from '../../../lib/application/services/TutorialService';

// Modo SSR: obtenemos la página desde los query params de la URL
const pageParam = Astro.url.searchParams.get('page');
const currentPage = pageParam ? parseInt(pageParam) : 1;
const pageSize = 9;

// Obtener datos de Supabase usando el servicio
const { data, totalPages } = await tutorialService.getPaginatedCatalog(currentPage, pageSize);

// Construir el objeto page compatible con el template existente de Astro
const page = {
  currentPage,
  lastPage: totalPages,
  data,
  url: {
    prev: currentPage > 1 ? (currentPage === 2 ? '/blog/guias' : `/blog/guias?page=${currentPage - 1}`) : undefined,
    next: currentPage < totalPages ? `/blog/guias?page=${currentPage + 1}` : undefined,
  }
};

// Configurar caché en el Edge (CDN) para el listado
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
---

<Layout
  title={`Guías y Tutoriales - Página ${page.currentPage} | HerramientasTIC`}
  description="Colección de guías paso a paso sobre Git, Astro, Docker, Kubernetes, AWS y desarrollo de software."
>
  <div class="py-8 space-y-8">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-orbynex-cyan px-3 py-1 rounded-full bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark shadow-sm">
        Documentación Técnica • Página {page.currentPage} de {page.lastPage}
      </span>
      <h1 class="text-3xl sm:text-5xl font-display font-black text-slate-900 dark:text-white">
        Guías & <span class="text-gradient">Tutoriales Prácticos</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-gray-300">
        Aprende paso a paso con nuestras guías técnicas de infraestructura, control de versiones, frontend y la nube.
      </p>
    </div>

    <!-- Buscador de Guías en tiempo real -->
    <div class="max-w-xl mx-auto relative">
      <input
        type="text"
        id="search-guides-input"
        placeholder="Buscar en esta página por tecnología (ej: Git, Docker, Astro)..."
        class="w-full px-5 py-3.5 rounded-2xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-gray-500 focus:outline-none focus:border-orbynex-cyan focus:ring-1 focus:ring-orbynex-cyan transition-all text-sm shadow-sm"
      />
      <span class="absolute right-4 top-3.5 text-slate-400 dark:text-gray-500">🔍</span>
    </div>

    <!-- Lista de Guías en Grid -->
    <div id="guides-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
      {page.data.map((guide: any) => (
        <a
          href={`/blog/guias/${guide.slug}`}
          class="guide-card group relative p-6 rounded-2xl bg-white dark:bg-[#0c1b3a] border border-slate-200 dark:border-orbynex-lineDark hover:border-orbynex-cyan/60 hover:-translate-y-1 transition-all duration-300 shadow-cardLight dark:shadow-cardDark flex flex-col justify-between cursor-pointer"
          data-title={guide.title.toLowerCase()}
          data-desc={guide.description.toLowerCase()}
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs font-mono text-orbynex-cyan">
              <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
                {new Date(guide.created_at).getFullYear()}
              </span>
              <span class="text-slate-500 dark:text-gray-400">{guide.category || 'Guía Práctica'}</span>
            </div>

            {guide.category && (
              <TutorialIcon category={guide.category} title={guide.title} size="md" />
            )}
            {!guide.category && (
              <TutorialIcon category="General" title={guide.title} size="md" />
            )}

            <div>
              <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white group-hover:text-orbynex-cyan transition-colors">
                {guide.title}
              </h2>
              <p class="text-xs text-slate-600 dark:text-gray-400 mt-2 leading-relaxed line-clamp-3">
                {guide.description}
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-slate-100 dark:border-orbynex-lineDark/60 mt-6 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-500 dark:text-gray-400">Lectura ~5 min</span>
            <div
              class="inline-flex items-center text-xs font-bold text-orbynex-cyan group-hover:translate-x-1 transition-transform"
            >
              Leer Guía <span class="ml-1">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Search State Container -->
    <div id="search-results-container" class="hidden">
      <div class="mb-4 flex items-center justify-between border-b border-slate-200 dark:border-orbynex-lineDark pb-2">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Resultados de Búsqueda</h3>
        <button id="clear-search-btn" class="text-xs font-bold text-orbynex-magenta hover:underline">Limpiar Búsqueda</button>
      </div>
      <div id="search-results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
        <!-- Rendered via JS -->
      </div>
    </div>

    <!-- Controles de Paginación Escalables -->
    <div id="pagination-controls">
      {page.lastPage > 1 && (
        <div class="flex items-center justify-center gap-4 pt-8 border-t border-slate-200 dark:border-orbynex-lineDark">
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="px-4 py-2 rounded-xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-700 dark:text-gray-300 hover:text-slate-900 dark:hover:text-white hover:border-orbynex-cyan text-xs font-bold transition-all shadow-sm"
            >
              ← Página Anterior
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark text-slate-400 dark:text-gray-600 text-xs font-bold cursor-not-allowed">
              ← Página Anterior
            </span>
          )}

          <span class="text-xs font-mono text-slate-500 dark:text-gray-400">
            Página <strong class="text-slate-900 dark:text-white">{page.currentPage}</strong> de {page.lastPage}
          </span>

          {page.url.next ? (
            <a
              href={page.url.next}
              class="px-4 py-2 rounded-xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-700 dark:text-gray-300 hover:text-slate-900 dark:hover:text-white hover:border-orbynex-cyan text-xs font-bold transition-all shadow-sm"
            >
              Página Siguiente →
            </a>
          ) : (
            <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark text-slate-400 dark:text-gray-600 text-xs font-bold cursor-not-allowed">
              Página Siguiente →
            </span>
          )}
        </div>
      )}
    </div>

  </div>

  <script is:inline>
    function initSearch() {
      const searchInput = document.getElementById('search-guides-input');
      const guidesGrid = document.getElementById('guides-grid'); // Original paginated grid
      const searchResultsContainer = document.getElementById('search-results-container');
      const searchResultsGrid = document.getElementById('search-results-grid');
      const paginationControls = document.getElementById('pagination-controls');
      const clearSearchBtn = document.getElementById('clear-search-btn');

      let allGuides = null;

      async function fetchGuides() {
        if (!allGuides) {
          const res = await fetch('/api/search.json');
          allGuides = await res.json();
        }
        return allGuides;
      }

      function renderCard(guide) {
        const titleLower = guide.title.toLowerCase();
        const descLower = guide.description.toLowerCase();
        
        return `
          <a
            href="/blog/guias/${guide.slug}"
            class="guide-card group relative p-6 rounded-2xl bg-white dark:bg-[#0c1b3a] border border-slate-200 dark:border-orbynex-lineDark hover:border-orbynex-cyan/60 hover:-translate-y-1 transition-all duration-300 shadow-cardLight dark:shadow-cardDark flex flex-col justify-between cursor-pointer"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between text-xs font-mono text-orbynex-cyan">
                <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
                  ${guide.updated || '2026'}
                </span>
                <span class="text-slate-500 dark:text-gray-400">${guide.category || 'Guía Práctica'}</span>
              </div>
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orbynex-cyan to-orbynex-blue p-[2px] shadow-md flex-shrink-0">
                <div class="w-full h-full bg-white dark:bg-orbynex-deepSpace rounded-[10px] flex items-center justify-center">
                  <svg class="w-3/5 h-3/5 text-orbynex-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                </div>
              </div>
              <div>
                <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white group-hover:text-orbynex-cyan transition-colors">
                  ${guide.title}
                </h2>
                <p class="text-xs text-slate-600 dark:text-gray-400 mt-2 leading-relaxed line-clamp-3">
                  ${guide.description}
                </p>
              </div>
            </div>
            <div class="pt-6 border-t border-slate-100 dark:border-orbynex-lineDark/60 mt-6 flex items-center justify-between">
              <span class="text-xs font-mono text-slate-500 dark:text-gray-400">Lectura ~5 min</span>
              <div class="inline-flex items-center text-xs font-bold text-orbynex-cyan group-hover:translate-x-1 transition-transform">
                Leer Guía <span class="ml-1">→</span>
              </div>
            </div>
          </a>
        `;
      }

      function clearSearch() {
        searchInput.value = '';
        guidesGrid.classList.remove('hidden');
        paginationControls.classList.remove('hidden');
        searchResultsContainer.classList.add('hidden');
      }

      clearSearchBtn?.addEventListener('click', clearSearch);

      searchInput?.addEventListener('input', async (e) => {
        const query = e.target.value.toLowerCase().trim();
        
        if (query.length === 0) {
          clearSearch();
          return;
        }

        const guides = await fetchGuides();
        const filtered = guides.filter(g => 
          g.title.toLowerCase().includes(query) || 
          g.description.toLowerCase().includes(query)
        );

        guidesGrid.classList.add('hidden');
        paginationControls.classList.add('hidden');
        searchResultsContainer.classList.remove('hidden');

        if (filtered.length > 0) {
          searchResultsGrid.innerHTML = filtered.map(renderCard).join('');
        } else {
          searchResultsGrid.innerHTML = `
            <div class="col-span-full py-12 text-center text-slate-500 dark:text-gray-400">
              No se encontraron guías que coincidan con "<strong>${query}</strong>".
            </div>
          `;
        }
      });
    }

    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  </script>
</Layout>
