---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const tutorials = await getCollection("tutorials");
  return tutorials.map((tut: CollectionEntry<"tutorials">) => ({
    params: { slug: tut.slug },
    props: { tutorial: tut as CollectionEntry<"tutorials"> },
  }));
}

const { tutorial } = Astro.props as { tutorial: CollectionEntry<"tutorials"> };
const { Content } = await tutorial.render();
---

<Layout title={`${tutorial.data.title} | Guías HerramientasTIC`} description={tutorial.data.description}>
  
  <!-- Reading Progress Bar -->
  <div id="read-progress" class="fixed top-20 left-0 h-1 bg-gradient-to-r from-orbynex-cyan via-orbynex-blue to-orbynex-magenta z-50 w-0 transition-all duration-150"></div>

  <article class="py-8 max-w-4xl mx-auto space-y-8">
    
    <!-- Botón Volver -->
    <a
      href="/blog/guias"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-orbynex-surfaceDark border border-orbynex-lineDark text-xs font-bold text-orbynex-cyan hover:border-orbynex-cyan transition-all shadow-sm"
    >
      ← Volver al catálogo de guías
    </a>

    <!-- Header del Artículo -->
    <header class="space-y-4 border-b border-orbynex-lineDark pb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-orbynex-cyan">
        <span class="px-3 py-1 rounded-full bg-orbynex-surfaceDark border border-orbynex-lineDark font-semibold">
          Guía Técnica
        </span>
        <span>•</span>
        <span>Actualizado: {tutorial.data.updated}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-display font-black text-white leading-tight">
        {tutorial.data.title}
      </h1>

      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        {tutorial.data.description}
      </p>

      <!-- Ficha de Autor -->
      <div class="flex items-center gap-3 pt-4">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-orbynex-cyan to-orbynex-magenta p-[2px]">
          <div class="w-full h-full bg-orbynex-deepSpace rounded-full flex items-center justify-center font-display font-bold text-white text-xs">
            CG
          </div>
        </div>
        <div>
          <span class="block text-xs font-bold text-white">Christian Galindez</span>
          <span class="block text-[10px] text-gray-400 font-mono">Backend, APIs & Cloud Architect</span>
        </div>
      </div>
    </header>

    <!-- Contenido del Artículo en Markdown Adaptativo -->
    <div class="prose-custom max-w-none">
      <Content />
    </div>

    <!-- Call to action al pie de la guía -->
    <footer class="pt-8 border-t border-orbynex-lineDark flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-gray-400">
        ¿Te sirvió esta guía? Compártela o explora más contenido técnico en <a href="https://noticias.orbynexdigital.cl" target="_blank" class="text-orbynex-cyan hover:underline font-bold">Noticias Orbynex</a>.
      </div>
      <a
        href="/blog/guias"
        class="px-5 py-2.5 rounded-xl text-xs font-bold bg-orbynex-surfaceDark border border-orbynex-lineDark text-white hover:border-orbynex-cyan transition-all"
      >
        Ver más guías →
      </a>
    </footer>

  </article>

  <script is:inline>
    function initProgress() {
      window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('read-progress');
        if (progressBar) {
          progressBar.style.width = scrolled + '%';
        }
      });
    }

    initProgress();
    document.addEventListener('astro:page-load', initProgress);
  </script>
</Layout>
