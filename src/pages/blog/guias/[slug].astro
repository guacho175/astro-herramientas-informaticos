---
import Layout from "../../../layouts/Layout.astro";
import { tutorialService } from "../../../lib/application/services/TutorialService";
import { marked } from "marked";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Obtener tutorial de Supabase
const tutorial = await tutorialService.getTutorialContent(slug);

if (!tutorial) {
  return Astro.redirect('/404');
}

// Configurar caché en el Edge (CDN) para ahorrar peticiones a Supabase
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

// Parsear el Markdown a HTML
const contentHtml = marked.parse(tutorial.content_markdown || '');
---

<Layout title={`${tutorial.title} | Guías HerramientasTIC`} description={tutorial.description}>
  
  <!-- Reading Progress Bar -->
  <div id="read-progress" class="fixed top-20 left-0 h-1 bg-gradient-to-r from-orbynex-cyan via-orbynex-blue to-orbynex-magenta z-50 w-0 transition-all duration-150"></div>

  <article class="py-8 max-w-4xl mx-auto space-y-8">
    
    <!-- Botón Volver -->
    <a
      href="/blog/guias"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-xs font-bold text-orbynex-cyan hover:border-orbynex-cyan transition-all shadow-sm"
    >
      ← Volver al catálogo de guías
    </a>

    <!-- Header del Artículo -->
    <header class="space-y-4 border-b border-slate-200 dark:border-orbynex-lineDark pb-8">
      <div class="flex items-center gap-3 text-xs font-mono text-orbynex-cyan">
        <span class="px-3 py-1 rounded-full bg-slate-100 dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark font-semibold">
          {tutorial.category || 'Guía Técnica'}
        </span>
        <span>•</span>
        <span>Vistas: {tutorial.views}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-display font-black text-slate-900 dark:text-white leading-tight">
        {tutorial.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-gray-300 leading-relaxed">
        {tutorial.description}
      </p>

      <!-- Ficha de Autor -->
      <div class="flex items-center gap-3 pt-4">
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-orbynex-cyan to-orbynex-magenta p-[2px]">
          <div class="w-full h-full bg-slate-900 dark:bg-orbynex-deepSpace rounded-full flex items-center justify-center font-display font-bold text-white text-xs">
            CG
          </div>
        </div>
        <div>
          <span class="block text-xs font-bold text-slate-900 dark:text-white">Christian Galindez</span>
          <span class="block text-[10px] text-slate-500 dark:text-gray-400 font-mono">Backend, APIs & Cloud Architect</span>
        </div>
      </div>
    </header>

    <!-- Contenido del Artículo parseado con marked -->
    <div class="prose-custom max-w-none" set:html={contentHtml} />

    <!-- Call to action al pie de la guía -->
    <footer class="pt-8 border-t border-slate-200 dark:border-orbynex-lineDark flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-xs text-slate-500 dark:text-gray-400">
        ¿Te sirvió esta guía? Compártela o explora más contenido técnico en <a href="https://noticias.orbynexdigital.cl" target="_blank" class="text-orbynex-cyan hover:underline font-bold">Noticias Orbynex</a>.
      </div>
      <a
        href="/blog/guias"
        class="px-5 py-2.5 rounded-xl text-xs font-bold bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-900 dark:text-white hover:border-orbynex-cyan transition-all shadow-sm"
      >
        Ver más guías →
      </a>
    </footer>

  </article>

  <script is:inline>
    function initProgress() {
      window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('read-progress');
        if (progressBar) {
          progressBar.style.width = scrolled + '%';
        }
      });
    }

    initProgress();
    document.addEventListener('astro:page-load', initProgress);
  </script>
</Layout>
