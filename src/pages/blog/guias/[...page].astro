---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const tutorials = await getCollection('tutorials');
  tutorials.sort((a, b) => (b.data.title > a.data.title ? 1 : -1));
  return paginate(tutorials, { pageSize: 9 });
}

const { page } = Astro.props;
---

<Layout
  title={`Guías y Tutoriales - Página ${page.currentPage} | HerramientasTIC`}
  description="Colección de guías paso a paso sobre Git, Astro, Docker, Kubernetes, AWS y desarrollo de software."
>
  <div class="py-8 space-y-8">
    
    <!-- Encabezado de la Sección -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-orbynex-cyan px-3 py-1 rounded-full bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark shadow-sm">
        Documentación Técnica • Página {page.currentPage} de {page.lastPage}
      </span>
      <h1 class="text-3xl sm:text-5xl font-display font-black text-slate-900 dark:text-white">
        Guías & <span class="text-gradient">Tutoriales Prácticos</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-gray-300">
        Aprende paso a paso con nuestras guías técnicas de infraestructura, control de versiones, frontend y la nube.
      </p>
    </div>

    <!-- Buscador de Guías en tiempo real -->
    <div class="max-w-xl mx-auto relative">
      <input
        type="text"
        id="search-guides-input"
        placeholder="Buscar en esta página por tecnología (ej: Git, Docker, Astro)..."
        class="w-full px-5 py-3.5 rounded-2xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-gray-500 focus:outline-none focus:border-orbynex-cyan focus:ring-1 focus:ring-orbynex-cyan transition-all text-sm shadow-sm"
      />
      <span class="absolute right-4 top-3.5 text-slate-400 dark:text-gray-500">🔍</span>
    </div>

    <!-- Lista de Guías en Grid -->
    <div id="guides-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
      {page.data.map((guide: any) => (
        <article
          class="guide-card group relative p-6 rounded-2xl bg-white dark:bg-orbynex-surfaceDark/70 border border-slate-200 dark:border-orbynex-lineDark hover:border-orbynex-cyan/50 dark:hover:bg-orbynex-surfaceStrong transition-all duration-300 shadow-cardLight dark:shadow-cardDark flex flex-col justify-between"
          data-title={guide.data.title.toLowerCase()}
          data-desc={guide.data.description.toLowerCase()}
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs font-mono text-orbynex-cyan">
              <span class="px-2.5 py-1 rounded-md bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
                {guide.data.updated || '2026'}
              </span>
              <span class="text-slate-500 dark:text-gray-400">Guía Práctica</span>
            </div>

            {guide.data.image && (
              <div class="w-12 h-12 rounded-xl bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark p-2 flex items-center justify-center">
                <img src={guide.data.image} alt={guide.data.title} class="w-full h-full object-contain" />
              </div>
            )}

            <div>
              <h2 class="text-xl font-display font-bold text-slate-900 dark:text-white group-hover:text-orbynex-cyan transition-colors">
                {guide.data.title}
              </h2>
              <p class="text-xs text-slate-600 dark:text-gray-400 mt-2 leading-relaxed line-clamp-3">
                {guide.data.description}
              </p>
            </div>
          </div>

          <div class="pt-6 border-t border-slate-100 dark:border-orbynex-lineDark/60 mt-6 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-500 dark:text-gray-400">Lectura ~5 min</span>
            <a
              href={`/blog/guias/${guide.data.slug || guide.slug}`}
              class="inline-flex items-center text-xs font-bold text-orbynex-cyan group-hover:translate-x-1 transition-transform"
            >
              Leer Guía <span class="ml-1">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Controles de Paginación Escalables -->
    {page.lastPage > 1 && (
      <div class="flex items-center justify-center gap-4 pt-8 border-t border-slate-200 dark:border-orbynex-lineDark">
        {page.url.prev ? (
          <a
            href={page.url.prev}
            class="px-4 py-2 rounded-xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-700 dark:text-gray-300 hover:text-slate-900 dark:hover:text-white hover:border-orbynex-cyan text-xs font-bold transition-all shadow-sm"
          >
            ← Página Anterior
          </a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark text-slate-400 dark:text-gray-600 text-xs font-bold cursor-not-allowed">
            ← Página Anterior
          </span>
        )}

        <span class="text-xs font-mono text-slate-500 dark:text-gray-400">
          Página <strong class="text-slate-900 dark:text-white">{page.currentPage}</strong> de {page.lastPage}
        </span>

        {page.url.next ? (
          <a
            href={page.url.next}
            class="px-4 py-2 rounded-xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-slate-700 dark:text-gray-300 hover:text-slate-900 dark:hover:text-white hover:border-orbynex-cyan text-xs font-bold transition-all shadow-sm"
          >
            Página Siguiente →
          </a>
        ) : (
          <span class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark text-slate-400 dark:text-gray-600 text-xs font-bold cursor-not-allowed">
            Página Siguiente →
          </span>
        )}
      </div>
    )}

  </div>

  <script is:inline>
    function initSearch() {
      const searchInput = document.getElementById('search-guides-input');
      const guideCards = document.querySelectorAll('.guide-card');

      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        guideCards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';
          if (title.includes(query) || desc.includes(query)) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    }

    initSearch();
    document.addEventListener('astro:page-load', initSearch);
  </script>
</Layout>
