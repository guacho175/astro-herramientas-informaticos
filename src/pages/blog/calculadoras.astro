---
import Layout from '../../layouts/Layout.astro';
import HerramientasDestacadas from '../../components/HerramientasDestacadas.astro';
import AdSlot from '../../components/AdSlot.astro';
import { siteConfig } from '../../config/site';

const title = 'Laboratorio de Recursos | Herramientas para Informáticos';
const description = 'Prototipos, calculadoras y widgets interactivos para complementar tus artículos y mejorar el tiempo en página.';
const keywords = [
  'calculadoras para programadores',
  'widgets interactivos',
  'recursos para blogs de tecnología',
];

const inFeedSlot = siteConfig.adsense?.slots.inFeed;
---
<Layout title={title} description={description} keywords={keywords}>
  <HerramientasDestacadas
    active="calculadoras"
    title="Laboratorio creativo"
    description="Experimenta con utilidades que mantienen a tu audiencia participando y aumentan los ingresos por anuncios."
  >
    <div class="space-y-6">
      <div class="space-y-4 rounded-2xl border border-blue-500/30 bg-blue-500/5 p-8 text-blue-50/90">
        <h2 class="text-2xl font-semibold text-white">Estamos construyendo la siguiente generación de recursos interactivos</h2>
        <p class="text-sm">
          Próximamente encontrarás estimadores de costos cloud, calculadoras de tarifas freelance, simuladores de crecimiento y widgets listos para embeber en tus artículos.
        </p>
        <ul class="grid gap-3 sm:grid-cols-2">
          <li class="rounded-2xl border border-blue-400/30 bg-slate-950/40 p-4 text-sm">
            <p class="font-semibold">Calculadora de propuestas</p>
            <p class="mt-2 text-xs text-blue-100/80">Genera presupuestos profesionales descargables en PDF.</p>
          </li>
          <li class="rounded-2xl border border-blue-400/30 bg-slate-950/40 p-4 text-sm">
            <p class="font-semibold">Estimador de costos cloud</p>
            <p class="mt-2 text-xs text-blue-100/80">Compara escenarios multicloud y planifica márgenes.</p>
          </li>
          <li class="rounded-2xl border border-blue-400/30 bg-slate-950/40 p-4 text-sm">
            <p class="font-semibold">Simulador de ingresos ads</p>
            <p class="mt-2 text-xs text-blue-100/80">Proyecta RPM, CTR y escenarios de posicionamiento SEO.</p>
          </li>
          <li class="rounded-2xl border border-blue-400/30 bg-slate-950/40 p-4 text-sm">
            <p class="font-semibold">Planificador de contenidos</p>
            <p class="mt-2 text-xs text-blue-100/80">Organiza campañas, formatos y objetivos por semana.</p>
          </li>
        </ul>
        <p class="text-xs text-blue-100/70">
          ¿Quieres acceso anticipado? Suscríbete a la newsletter y te avisaremos en cuanto estén disponibles.
        </p>
      </div>
      <AdSlot slot={inFeedSlot} label="Anuncio en laboratorio" layout="in-feed" />
    </div>
  </HerramientasDestacadas>
</Layout>
