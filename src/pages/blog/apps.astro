---
import Layout from '../../layouts/Layout.astro';
import HerramientasDestacadas from '../../components/HerramientasDestacadas.astro';
import ToolsCards from '../../components/ToolsCards.astro';
import SearchBar from '../../components/BarraBusqueda.astro';

const title = 'Aplicaciones Recomendadas | Herramientas para Informáticos';
const description = 'Stack curado de software para optimizar tus operaciones, propuestas y entregables en tecnología.';
const keywords = [
  'apps para informáticos',
  'herramientas para desarrolladores',
  'software productividad TI',
];
---
<Layout title={title} description={description} keywords={keywords}>
  <HerramientasDestacadas
    active="apps"
    title="Aplicaciones imprescindibles"
    description="Evalúa y adopta herramientas que aceleran tus proyectos técnicos sin comprometer la calidad."
  >
    <div class="space-y-6">
      <div class="space-y-3">
        <h2 class="text-2xl font-semibold text-white">Explora el stack</h2>
        <p class="text-sm text-slate-300">
          Filtra por nombre, categoría o etiqueta para descubrir soluciones que cubren documentación, automatización, analítica y diseño.
        </p>
      </div>
      <SearchBar placeholder="Buscar aplicación..." targetSelector=".tool-card" />
      <ToolsCards />
    </div>
  </HerramientasDestacadas>
</Layout>
