---
import Layout from '../../../layouts/Layout.astro';
import { calculators } from '../../../data/calculators.js';
import ConversorAlmacenamiento from '../../../components/calculadoras/ConversorAlmacenamiento.astro';
import CalculadoraSubredes from '../../../components/calculadoras/CalculadoraSubredes.astro';
import GeneradorPasswords from '../../../components/calculadoras/GeneradorPasswords.astro';
import BasesNumericas from '../../../components/calculadoras/BasesNumericas.astro';
import GeneradorHash from '../../../components/calculadoras/GeneradorHash.astro';
import AnchoBanda from '../../../components/calculadoras/AnchoBanda.astro';

export async function getStaticPaths() {
  return calculators.map((calc) => ({
    params: { slug: calc.slug },
    props: { calculator: calc },
  }));
}

const { calculator } = Astro.props;

// Component Map for dynamic rendering
const calcMap: Record<string, any> = {
  'almacenamiento': ConversorAlmacenamiento,
  'subredes-ip': CalculadoraSubredes,
  'generador-contrasenas': GeneradorPasswords,
  'bases-numericas': BasesNumericas,
  'generador-hash': GeneradorHash,
  'ancho-banda': AnchoBanda
};

const CurrentCalculator = calcMap[calculator.slug];
---

<Layout
  title={`${calculator.title} | Calculadoras HerramientasTIC`}
  description={calculator.description}
>
  <div class="py-8 max-w-3xl mx-auto space-y-8">
    
    <!-- Navigation Back Button -->
    <a
      href="/blog/calculadoras"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark text-xs font-bold text-orbynex-cyan hover:text-white hover:border-orbynex-cyan transition-all"
    >
      ← Volver al catálogo de calculadoras
    </a>

    <!-- Calculator Title Header -->
    <header class="space-y-3 border-b border-slate-200 dark:border-orbynex-lineDark pb-6">
      <div class="flex items-center gap-3">
        <span class="text-4xl p-3 rounded-2xl bg-white dark:bg-orbynex-surfaceDark border border-slate-200 dark:border-orbynex-lineDark">
          {calculator.icon}
        </span>
        <div>
          <span class="text-xs font-mono font-bold text-orbynex-cyan uppercase tracking-wider">
            {calculator.category} • {calculator.badge}
          </span>
          <h1 class="text-2xl sm:text-4xl font-display font-black text-slate-900 dark:text-white">
            {calculator.title}
          </h1>
        </div>
      </div>
      <p class="text-sm text-slate-600 dark:text-gray-300 leading-relaxed pt-1">
        {calculator.description}
      </p>
    </header>

    <!-- CALCULATOR CONTENT BY SLUG -->
    <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#0c1b3a] border border-slate-200 dark:border-orbynex-lineDark shadow-2xl space-y-6">
      {CurrentCalculator && <CurrentCalculator />}
    </div>

  </div>
</Layout>
