---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Página no encontrada | HerramientasTIC">
  <div class="py-20 text-center max-w-2xl mx-auto space-y-6">
    <div class="inline-block px-4 py-1.5 rounded-full bg-orbynex-surfaceDark border border-orbynex-magenta/40 text-orbynex-magenta font-mono text-sm font-bold shadow-glowMagenta">
      Error 404 - Ruta no encontrada
    </div>
    
    <h1 class="text-6xl sm:text-8xl font-display font-black text-white">
      40<span class="text-gradient">4</span>
    </h1>

    <p class="text-base text-gray-300">
      La página que buscas no existe o ha sido movida dentro del portal.
    </p>

    <div class="pt-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-2xl font-display font-bold text-sm bg-gradient-to-r from-orbynex-cyan via-orbynex-blue to-orbynex-magenta text-white shadow-glowCyan hover:scale-105 transition-all"
      >
        ← Volver al Inicio
      </a>
    </div>
  </div>
</Layout>
