---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';

const title = 'Contacto | Herramientas para Informáticos';
const description = 'Propuestas editoriales, alianzas de contenido y campañas publicitarias para audiencias tecnológicas.';
const keywords = [
  'contacto blog tecnología',
  'publicidad google adsense',
  'colaboraciones contenido',
];
---
<Layout title={title} description={description} keywords={keywords}>
  <section class="grid gap-10 lg:grid-cols-[minmax(0,1fr),360px]">
    <div class="space-y-6">
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-400">Hablemos</p>
        <h1 class="text-3xl font-bold text-white">Colaboremos en contenidos, campañas o cobertura de herramientas</h1>
        <p class="text-sm text-slate-300">
          Cuéntanos tu idea: desde reseñas patrocinadas hasta lanzamientos de productos o propuestas de invitado. Respondemos con
          tarifas, formatos disponibles y fechas en agenda.
        </p>
      </div>
      <form class="space-y-4 rounded-3xl border border-slate-800 bg-slate-900/70 p-6 shadow shadow-blue-500/10" name="contacto" method="post" data-netlify="true">
        <input type="hidden" name="form-name" value="contacto" />
        <div class="grid gap-4 md:grid-cols-2">
          <label class="space-y-1 text-sm text-slate-200">
            Nombre completo
            <input
              type="text"
              name="nombre"
              required
              class="w-full rounded-xl border border-slate-700 bg-slate-950/60 px-4 py-3 text-sm text-slate-100 focus:border-blue-400 focus:outline-none"
            />
          </label>
          <label class="space-y-1 text-sm text-slate-200">
            Correo profesional
            <input
              type="email"
              name="correo"
              required
              class="w-full rounded-xl border border-slate-700 bg-slate-950/60 px-4 py-3 text-sm text-slate-100 focus:border-blue-400 focus:outline-none"
            />
          </label>
        </div>
        <label class="space-y-1 text-sm text-slate-200">
          Tipo de colaboración
          <select
            name="proyecto"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/60 px-4 py-3 text-sm text-slate-100 focus:border-blue-400 focus:outline-none"
            required
          >
            <option value="patrocinio">Campaña publicitaria / patrocinio</option>
            <option value="lanzamiento">Lanzamiento de producto o herramienta</option>
            <option value="guest-post">Artículo invitado</option>
            <option value="entrevista">Entrevista o colaboración multimedia</option>
          </select>
        </label>
        <label class="space-y-1 text-sm text-slate-200">
          Objetivo principal
          <textarea
            name="objetivo"
            rows="4"
            class="w-full rounded-xl border border-slate-700 bg-slate-950/60 px-4 py-3 text-sm text-slate-100 focus:border-blue-400 focus:outline-none"
            required
          ></textarea>
        </label>
        <button
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-full bg-blue-500 px-6 py-3 text-sm font-semibold text-white shadow shadow-blue-500/30 transition hover:bg-blue-400"
        >
          Enviar mensaje
        </button>
        <p class="text-xs text-slate-500">Revisamos cada propuesta con criterios editoriales y respondemos en menos de 48 horas.</p>
      </form>
    </div>

    <aside class="space-y-4 rounded-3xl border border-slate-800 bg-slate-900/40 p-6 text-sm text-slate-300">
      <h2 class="text-lg font-semibold text-white">Formatos disponibles</h2>
      <ul class="space-y-3">
        <li>
          <p class="font-semibold text-blue-200">Integraciones AdSense</p>
          <p class="text-xs text-slate-400">Guía para ubicar tus anuncios, métricas sugeridas y buenas prácticas de velocidad.</p>
        </li>
        <li>
          <p class="font-semibold text-blue-200">Reportajes y reseñas</p>
          <p class="text-xs text-slate-400">Cobertura editorial de herramientas o lanzamientos con orientación educativa.</p>
        </li>
        <li>
          <p class="font-semibold text-blue-200">Colaboraciones de comunidad</p>
          <p class="text-xs text-slate-400">Participa en newsletters, reels o transmisiones en vivo con temas de actualidad.</p>
        </li>
      </ul>
      <div class="rounded-2xl border border-blue-500/30 bg-blue-500/10 p-4 text-xs text-blue-100">
        <p class="font-semibold">¿Prefieres escribirnos directamente?</p>
        <p>Escríbenos a <a href={`mailto:${siteConfig.contactEmail}`} class="underline">{siteConfig.contactEmail}</a>.</p>
      </div>
    </aside>
  </section>
</Layout>
