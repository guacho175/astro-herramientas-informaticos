---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HerramientasDestacadas from '../components/HerramientasDestacadas.astro';
import { getCollection } from 'astro:content';
import { calculators } from '../data/calculators.js';

const tutorials = await getCollection('tutorials');
const latestTutorials = tutorials.slice(0, 6);
const topCalculators = calculators.slice(0, 4);
---

<Layout
  title="HerramientasTIC | Recursos, Apps y Calculadoras Informáticas por Orbynex Digital"
  description="Portal de insumos informáticos, calculadoras técnicas, tutoriales de programación y herramientas de productividad por Orbynex Digital."
>
  <!-- Hero Section -->
  <Hero />

  <!-- Sección de Calculadoras Técnicas (Foco Principal) -->
  <section class="py-10 border-t border-slate-200 dark:border-orbynex-lineDark">
    <div class="flex items-center justify-between mb-8">
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-orbynex-magenta">Módulo de Cómputo</span>
        <h2 class="text-2xl sm:text-3xl font-display font-black text-slate-900 dark:text-white mt-1">Calculadoras Técnicas</h2>
      </div>
      <a href="/blog/calculadoras" class="text-xs font-display font-bold text-orbynex-magenta hover:underline flex items-center gap-1">
        Ver todas las calculadoras <span class="ml-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {topCalculators.map((calc) => (
        <a
          href={`/blog/calculadoras/${calc.slug}`}
          class="group relative p-5 rounded-2xl bg-white dark:bg-[#0c1b3a] border border-slate-200 dark:border-orbynex-lineDark hover:border-orbynex-magenta/60 hover:-translate-y-1 transition-all duration-300 shadow-cardLight dark:shadow-cardDark flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2 rounded-xl bg-slate-50 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">
                {calc.icon}
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-slate-100 dark:bg-orbynex-deepSpace text-orbynex-magenta border border-slate-200 dark:border-orbynex-magenta/30">
                {calc.badge}
              </span>
            </div>

            <div>
              <h3 class="font-display font-bold text-base text-slate-900 dark:text-white group-hover:text-orbynex-magenta transition-colors">
                {calc.title}
              </h3>
              <p class="text-xs text-slate-500 dark:text-gray-400 mt-1 line-clamp-2">
                {calc.description}
              </p>
            </div>
          </div>

          <div class="pt-4 text-xs font-bold text-orbynex-magenta flex items-center group-hover:translate-x-1 transition-transform">
            Abrir calculadora <span class="ml-1">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Sección de Guías & Tutoriales (Foco Principal) -->
  <section class="py-10 border-t border-slate-200 dark:border-orbynex-lineDark">
    <div class="flex items-center justify-between mb-8">
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-orbynex-cyan">Documentación Técnica</span>
        <h2 class="text-2xl sm:text-3xl font-display font-black text-slate-900 dark:text-white mt-1">Guías & Tutoriales Prácticos</h2>
      </div>
      <a href="/blog/guias" class="text-xs font-display font-bold text-orbynex-cyan hover:underline flex items-center gap-1">
        Explorar todas las guías <span class="ml-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestTutorials.map((guide) => (
        <a
          href={`/blog/guias/${guide.data.slug || guide.slug}`}
          class="group p-5 rounded-2xl bg-white dark:bg-[#0c1b3a] border border-slate-200 dark:border-orbynex-lineDark hover:border-orbynex-cyan/60 hover:-translate-y-1 transition-all duration-300 shadow-cardLight dark:shadow-cardDark flex flex-col justify-between cursor-pointer"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between text-xs text-orbynex-cyan font-mono">
              <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-orbynex-deepSpace border border-slate-200 dark:border-orbynex-lineDark">{guide.data.updated || '2026'}</span>
              <span class="text-slate-400 dark:text-gray-400">Guía Práctica</span>
            </div>
            <h3 class="font-display font-bold text-lg text-slate-900 dark:text-white group-hover:text-orbynex-cyan transition-colors">
              {guide.data.title}
            </h3>
            <p class="text-xs text-slate-500 dark:text-gray-400 line-clamp-2">
              {guide.data.description}
            </p>
          </div>

          <div class="pt-4 text-xs font-bold text-orbynex-cyan flex items-center group-hover:translate-x-1 transition-transform">
            Leer tutorial completo <span class="ml-1">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Herramientas Destacadas -->
  <HerramientasDestacadas />

</Layout>
