---
import Layout from '../../layouts/Layout.astro';
import { adminAuthService } from '../../lib/application/services/AdminAuthService';

const session = adminAuthService.getSession(Astro.request);
const isAuthenticated = Boolean(session);
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Layout title="Administración | HerramientasTIC" description="Panel de administración de tutoriales.">
  <div class="max-w-5xl mx-auto py-8 sm:py-12">
    {isAuthenticated ? (
      <section id="admin-panel" aria-busy="false">
        <header class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-orbynex-cyan">Administración autenticada</p>
            <h1 class="mt-2 text-3xl sm:text-4xl font-display font-black text-slate-900 dark:text-white">Panel de tutoriales</h1>
            <p class="mt-3 max-w-2xl text-slate-600 dark:text-gray-400">
              Elige el flujo adecuado. Las operaciones se validan en el servidor y pueden tardar varios minutos.
            </p>
          </div>
          <button
            id="logout-button"
            type="button"
            class="min-h-11 rounded-xl border border-slate-300 dark:border-orbynex-lineDark px-4 py-2 text-sm font-bold text-slate-700 dark:text-gray-200 hover:border-orbynex-cyan hover:text-orbynex-cyan focus:outline-none focus:ring-2 focus:ring-orbynex-cyan"
          >
            Cerrar sesión
          </button>
        </header>

        <div class="grid gap-6 md:grid-cols-2">
          <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl dark:border-orbynex-lineDark dark:bg-orbynex-surface">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orbynex-cyan/15 text-xl" aria-hidden="true">✦</span>
              <div>
                <h2 class="text-xl font-display font-black text-slate-900 dark:text-white">Generación manual con Gemini</h2>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-gray-400">
                  Redacta un tutorial sobre el tema que indiques usando la integración manual de Google AI Studio.
                </p>
              </div>
            </div>

            <form id="manual-generator-form" class="mt-6 space-y-4">
              <div>
                <label for="topic" class="mb-2 block text-sm font-bold text-slate-700 dark:text-slate-300">Tema o título del tutorial</label>
                <input
                  id="topic"
                  name="topic"
                  type="text"
                  required
                  maxlength="200"
                  autocomplete="off"
                  placeholder="Ej: Patrones de diseño en React"
                  class="min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:ring-2 focus:ring-orbynex-cyan dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                />
              </div>
              <button
                id="manual-submit-button"
                type="submit"
                class="min-h-11 w-full rounded-xl bg-gradient-to-r from-orbynex-cyan to-orbynex-blue px-4 py-3 font-bold text-white shadow-lg transition hover:shadow-orbynex-cyan/30 disabled:cursor-not-allowed disabled:opacity-60 focus:outline-none focus:ring-2 focus:ring-orbynex-cyan focus:ring-offset-2"
              >
                Generar y guardar tutorial
              </button>
            </form>
            <div id="manual-status" class="mt-4 hidden rounded-xl p-4 text-sm" role="status" aria-live="polite"></div>
          </article>

          <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl dark:border-orbynex-lineDark dark:bg-orbynex-surface">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orbynex-blue/15 text-xl" aria-hidden="true">↻</span>
              <div>
                <h2 class="text-xl font-display font-black text-slate-900 dark:text-white">Generación automática con Vercel AI Gateway</h2>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-gray-400">
                  Ejecuta los dos slots diarios con investigación de fuentes y el mismo control de idempotencia que usa el cron.
                </p>
              </div>
            </div>

            <div class="mt-6 rounded-2xl border border-orbynex-cyan/25 bg-orbynex-cyan/5 p-4 text-sm leading-6 text-slate-700 dark:text-gray-300">
              Si ya se ejecutó hoy, los slots se omitirán: esta acción no genera cuatro tutoriales. La operación consume créditos y publica en Supabase.
            </div>
            <button
              id="automatic-submit-button"
              type="button"
              class="mt-5 min-h-11 w-full rounded-xl border border-orbynex-cyan bg-orbynex-cyan/10 px-4 py-3 font-bold text-slate-800 transition hover:bg-orbynex-cyan hover:text-slate-950 disabled:cursor-not-allowed disabled:opacity-60 focus:outline-none focus:ring-2 focus:ring-orbynex-cyan focus:ring-offset-2 dark:text-white"
            >
              Generar los 2 tutoriales automáticos de hoy
            </button>
            <div id="automatic-status" class="mt-4 hidden rounded-xl p-4 text-sm" role="status" aria-live="polite"></div>
            <ol id="automatic-results" class="mt-3 space-y-2 text-sm text-slate-700 dark:text-gray-300" aria-live="polite"></ol>
          </article>
        </div>
      </section>
    ) : (
      <section class="mx-auto max-w-md rounded-3xl border border-slate-200 bg-white p-7 shadow-xl dark:border-orbynex-lineDark dark:bg-orbynex-surface sm:p-8">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-orbynex-cyan">Acceso restringido</p>
        <h1 class="mt-3 text-3xl font-display font-black text-slate-900 dark:text-white">Ingresar al panel</h1>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-gray-400">
          Usa la contraseña administrativa para iniciar una sesión segura y temporal.
        </p>
        <form id="login-form" class="mt-7 space-y-5">
          <div>
            <label for="password" class="mb-2 block text-sm font-bold text-slate-700 dark:text-slate-300">Contraseña administrativa</label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              class="min-h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none transition focus:ring-2 focus:ring-orbynex-cyan dark:border-slate-700 dark:bg-slate-800 dark:text-white"
            />
          </div>
          <button
            id="login-submit-button"
            type="submit"
            class="min-h-11 w-full rounded-xl bg-gradient-to-r from-orbynex-cyan to-orbynex-blue px-4 py-3 font-bold text-white shadow-lg transition hover:shadow-orbynex-cyan/30 disabled:cursor-not-allowed disabled:opacity-60 focus:outline-none focus:ring-2 focus:ring-orbynex-cyan focus:ring-offset-2"
          >
            Iniciar sesión
          </button>
        </form>
        <div id="login-status" class="mt-4 hidden rounded-xl p-4 text-sm" role="alert" aria-live="assertive"></div>
      </section>
    )}
  </div>

  <script is:inline>
    const jsonHeaders = { 'Content-Type': 'application/json' };

    async function readResponse(response) {
      try {
        return await response.json();
      } catch {
        return {};
      }
    }

    function showStatus(element, message, type = 'success') {
      element.textContent = message;
      element.className = `mt-4 rounded-xl p-4 text-sm ${type === 'success'
        ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300'
        : 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300'}`;
      element.classList.remove('hidden');
    }

    const loginForm = document.getElementById('login-form');
    if (loginForm) {
      const loginButton = document.getElementById('login-submit-button');
      const loginStatus = document.getElementById('login-status');
      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const password = document.getElementById('password').value;
        loginButton.disabled = true;
        loginButton.textContent = 'Iniciando sesión…';
        loginStatus.classList.add('hidden');

        try {
          const response = await fetch('/api/admin/login.json', {
            method: 'POST',
            headers: jsonHeaders,
            body: JSON.stringify({ password }),
          });
          const result = await readResponse(response);
          if (!response.ok) throw new Error(result.error || 'No fue posible iniciar sesión.');
          window.location.assign('/admin');
        } catch (error) {
          showStatus(loginStatus, error instanceof Error ? error.message : 'No fue posible iniciar sesión.', 'error');
          loginButton.disabled = false;
          loginButton.textContent = 'Iniciar sesión';
        }
      });
    }

    const panel = document.getElementById('admin-panel');
    if (panel) {
      const manualForm = document.getElementById('manual-generator-form');
      const manualButton = document.getElementById('manual-submit-button');
      const manualStatus = document.getElementById('manual-status');
      const automaticButton = document.getElementById('automatic-submit-button');
      const automaticStatus = document.getElementById('automatic-status');
      const automaticResults = document.getElementById('automatic-results');
      const logoutButton = document.getElementById('logout-button');
      let busy = false;

      function setBusy(nextBusy, label) {
        busy = nextBusy;
        panel.setAttribute('aria-busy', String(nextBusy));
        manualButton.disabled = nextBusy;
        automaticButton.disabled = nextBusy;
        manualButton.textContent = nextBusy && label === 'manual' ? 'Generando…' : 'Generar y guardar tutorial';
        automaticButton.textContent = nextBusy && label === 'automatic'
          ? 'Generando los tutoriales…'
          : 'Generar los 2 tutoriales automáticos de hoy';
      }

      function renderAutomaticResults(results) {
        automaticResults.replaceChildren();
        if (!Array.isArray(results)) return;
        for (const result of results) {
          const item = document.createElement('li');
          item.className = 'rounded-xl border border-slate-200 px-3 py-2 dark:border-orbynex-lineDark';
          const prefix = `Slot ${result.slot}: `;
          if (result.status === 'created') {
            item.textContent = `${prefix}creado — ${result.title} (${result.slug})`;
          } else if (result.status === 'skipped') {
            item.textContent = `${prefix}omitido — ${result.slug}`;
          } else {
            item.textContent = `${prefix}falló — ${result.error || 'Error de generación'}`;
          }
          automaticResults.append(item);
        }
      }

      manualForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (busy) return;
        const topic = document.getElementById('topic').value;
        manualStatus.classList.add('hidden');
        setBusy(true, 'manual');
        try {
          const response = await fetch('/api/admin/generate.json', {
            method: 'POST',
            headers: jsonHeaders,
            body: JSON.stringify({ topic }),
          });
          const result = await readResponse(response);
          if (!response.ok) throw new Error(result.error || 'No fue posible generar el tutorial.');
          showStatus(manualStatus, `Tutorial creado: ${result.data.title} (${result.data.slug}).`);
          manualForm.reset();
        } catch (error) {
          showStatus(manualStatus, error instanceof Error ? error.message : 'No fue posible generar el tutorial.', 'error');
        } finally {
          setBusy(false, '');
        }
      });

      automaticButton.addEventListener('click', async () => {
        if (busy) return;
        const confirmed = window.confirm(
          'Esta operación consume créditos y puede publicar hasta dos tutoriales en Supabase. ¿Quieres continuar?',
        );
        if (!confirmed) return;

        automaticStatus.classList.add('hidden');
        automaticResults.replaceChildren();
        setBusy(true, 'automatic');
        try {
          const response = await fetch('/api/admin/generate-emerging.json', {
            method: 'POST',
            headers: jsonHeaders,
            body: JSON.stringify({}),
          });
          const result = await readResponse(response);
          renderAutomaticResults(result.results);
          if (!response.ok) throw new Error(result.error || result.message || 'La generación automática no se completó.');
          showStatus(automaticStatus, result.message || 'Ejecución automática completada.');
        } catch (error) {
          showStatus(automaticStatus, error instanceof Error ? error.message : 'La generación automática no se completó.', 'error');
        } finally {
          setBusy(false, '');
        }
      });

      logoutButton.addEventListener('click', async () => {
        logoutButton.disabled = true;
        try {
          await fetch('/api/admin/logout.json', {
            method: 'POST',
            headers: jsonHeaders,
            body: JSON.stringify({}),
          });
        } finally {
          window.location.assign('/admin');
        }
      });
    }
  </script>
</Layout>
